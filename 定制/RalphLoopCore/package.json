{
  "name": "@custom/ralph-loop-core",
  "version": "2.0.0",
  "description": "RalphLoopCore - Intelligent session orchestration and strategy scheduling system",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs --format esm --dts",
    "dev": "tsup src/index.ts --format cjs --format esm --dts --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src --ext .ts"
  },
  "keywords": [
    "opencode",
    "agent",
    "orchestration",
    "strategy",
    "session",
    "loop",
    "pipeline"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.10.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0",
    "@vitest/coverage-v8": "^1.0.0",
    "eslint": "^8.55.0",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0"
  },
  "dependencies": {
    "effect": "^3.0.0",
    "zod": "^3.22.0"
  },
  "peerDependencies": {
    "typescript": "^5.0.0"
  }
}
