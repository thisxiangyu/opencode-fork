{
  "$schema": "https://opencode.ai/config.json",
  "provider": {},
  "permission": {
    "edit": {
      "packages/opencode/migration/*": "deny",
    },
  }, 
  "mcp": {
    "github": {
      "type": "local",
      "command": ["bun", "x", "@modelcontextprotocol/server-github"],
      "enabled": true,
      "environment": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": ""
      }
    },
  },
  "tools": {
    "github-triage": false,
    "github-pr-search": false,
  },
}
